+        tx().executeWithoutResult(s -> adapter.save(a));
+
+        List<Sale> found = tx().execute(s ->
+                adapter.findByStoreIdAndStatus(storeId, SaleStatus.PENDING_VALIDATION));
+
+        assertThat(found).singleElement().satisfies(sale -> {
+            assertThat(sale.getId()).isEqualTo(a.getId());
+            assertThat(sale.getItems()).hasSize(2);
+        });
+    }
+
+    // ── helpers ──────────────────────────────────────────────────────────────
