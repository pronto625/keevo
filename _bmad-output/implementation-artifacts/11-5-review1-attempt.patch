+ * Story 11.5 — keyset pull indexes ({@code (cursor, CAST(id AS text))} per delta table) on a real
+ * PostgreSQL: created by provisioning for new tenants and by the boot/request schema sync for
+ * existing ones, idempotently, and matching the delta query shape so the planner uses them.
+ *
+ * <p>Commits tenant schemas: each test uses its own schema name.</p>
+ */
+@DataJpaTest(properties = "spring.jpa.hibernate.ddl-auto=validate")
+@Import({TenantSchemaProvisioner.class, TenantSchemaSyncService.class, TenantSchemaMigrationRunner.class})
+@Transactional(propagation = Propagation.NOT_SUPPORTED)
+@DisplayName("Keyset pull indexes on tenant schemas (Story 11.5)")
+class SyncKeysetIndexesPostgresIntegrationTest extends PostgresIntegrationTest {
+
+    /** index name → table, one per table read through DeltaPageQuery. */
+    private static final Map<String, String> INDEXES = Map.ofEntries(
+            Map.entry("idx_products_sync_keyset", "products"),
+            Map.entry("idx_categories_sync_keyset", "categories"),
+            Map.entry("idx_stores_sync_keyset", "stores"),
+            Map.entry("idx_clients_sync_keyset", "clients"),
+            Map.entry("idx_suppliers_sync_keyset", "suppliers"),
+            Map.entry("idx_employees_sync_keyset", "employees"),
+            Map.entry("idx_sales_sync_keyset", "sales"),
+            Map.entry("idx_stock_levels_sync_keyset", "stock_levels"),
+            Map.entry("idx_stock_movements_sync_keyset", "stock_movements"),
+            Map.entry("idx_stock_transfers_sync_keyset", "stock_transfers"),
+            Map.entry("idx_audit_log_sync_keyset", "audit_log"),
+            Map.entry("idx_day_closures_sync_keyset", "day_closures"),
+            Map.entry("idx_inventory_sessions_sync_keyset", "inventory_sessions"),
+            Map.entry("idx_inventory_counts_sync_keyset", "inventory_counts"),
+            Map.entry("idx_reports_sync_keyset", "reports"));
+
+    @Autowired JdbcTemplate jdbc;
+    @Autowired DataSource dataSource;
+    @Autowired TenantSchemaProvisioner provisioner;
+    @Autowired TenantSchemaSyncService syncService;
+    @Autowired TenantSchemaMigrationRunner runner;
+
+    @Test
+    @DisplayName("provision(): a new tenant schema gets every keyset index, on (cursor, id::text)")
+    void provisionCreatesKeysetIndexes() {
+        String schema = "kv_ksi001";
+        provisioner.provision("tenant-ksi1", schema);
+
+        assertThat(keysetIndexes(schema)).containsOnlyKeys(INDEXES.keySet().toArray(String[]::new));
+        assertThat(keysetIndexes(schema)).allSatisfy((name, def) -> assertThat(def)
+                .as(name).contains("ON " + schema + "." + INDEXES.get(name)).contains("((id)::text)"));
+        assertThat(keysetIndexes(schema).get("idx_sales_sync_keyset")).contains("(updated_at, ((id)::text))");
+        assertThat(keysetIndexes(schema).get("idx_day_closures_sync_keyset")).contains("(received_at, ((id)::text))");
+        assertThat(keysetIndexes(schema).get("idx_stock_transfers_sync_keyset"))
+                .contains("GREATEST(occurred_at, COALESCE(updated_at, occurred_at))");
+    }
+
+    @Test
+    @DisplayName("boot: an existing tenant without the indexes gets them from the runner; a re-sync is idempotent")
+    void runnerCreatesKeysetIndexesOnExistingTenant() throws Exception {
+        String schema = "kv_ksi002";
+        provisioner.provision("tenant-ksi2", schema);
+        for (String index : INDEXES.keySet()) {
+            jdbc.execute("DROP INDEX \"" + schema + "\"." + index);
+        }
+        assertThat(keysetIndexes(schema)).isEmpty();
+        registerTenant(schema, "KV-KSI002");
+        try {
+            runner.runAll();
+            assertThat(keysetIndexes(schema)).containsOnlyKeys(INDEXES.keySet().toArray(String[]::new));
+
+            syncService.syncNow(schema); // second pass: IF NOT EXISTS, no duplicate, no failure
+            assertThat(keysetIndexes(schema)).hasSize(INDEXES.size());
+        } finally {
+            jdbc.update("DELETE FROM public.tenants WHERE schema_name = ?", schema);
+        }
+    }
+
+    @Test
+    @DisplayName("the delta page query shape (cursor >= since ORDER BY cursor, CAST(id AS text)) uses the index")
+    void deltaQueryUsesKeysetIndex() throws Exception {
+        String schema = "kv_ksi003";
+        provisioner.provision("tenant-ksi3", schema);
+
+        assertThat(explain(schema, "sales", "updated_at")).contains("idx_sales_sync_keyset");
+        assertThat(explain(schema, "stock_transfers", "GREATEST(occurred_at, COALESCE(updated_at, occurred_at))"))
+                .contains("idx_stock_transfers_sync_keyset");
+    }
+
+    // ── helpers ──────────────────────────────────────────────────────────────
+
+    private Map<String, String> keysetIndexes(String schema) {
+        List<Map<String, Object>> rows = jdbc.queryForList(
+                "SELECT indexname, indexdef FROM pg_indexes WHERE schemaname = ? AND indexname LIKE '%_sync_keyset'",
+                schema);
+        return rows.stream().collect(java.util.stream.Collectors.toMap(
+                r -> (String) r.get("indexname"), r -> (String) r.get("indexdef")));
+    }
+
+    /** EXPLAIN of the DeltaPageQuery SQL with seq scans disabled (empty tables would otherwise seq-scan). */
+    private String explain(String schema, String table, String cursor) throws Exception {
+        String sql = "EXPLAIN SELECT id, " + cursor + " AS sync_cursor FROM \"" + schema + "\"." + table
+                + " WHERE " + cursor + " >= now() - interval '1 day'"
+                + " AND (" + cursor + " > now() - interval '1 hour' OR (" + cursor + " = now() - interval '1 hour'"
+                + " AND CAST(id AS text) > '0'))"
+                + " ORDER BY " + cursor + ", CAST(id AS text) LIMIT 51";
+        StringBuilder plan = new StringBuilder();
+        try (Connection conn = dataSource.getConnection(); Statement stmt = conn.createStatement()) {
+            stmt.execute("SET enable_seqscan = off");
+            try (ResultSet rs = stmt.executeQuery(sql)) {
+                while (rs.next()) plan.append(rs.getString(1)).append('\n');
+            } finally {
+                stmt.execute("RESET enable_seqscan");
+            }
+        }
+        return plan.toString();
+    }
+
+    private void registerTenant(String schema, String code) {
+        jdbc.update("INSERT INTO public.tenants (id, created_at, updated_at, code, max_employees, max_products, "
+                + "max_stores, plan_type, schema_name, status) "
+                + "VALUES (?, now(), now(), ?, 1, 1, 1, 'FREE', ?, 'ACTIVE')", UUID.randomUUID(), code, schema);
+    }
+}
