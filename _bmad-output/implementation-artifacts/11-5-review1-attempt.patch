+    private TransactionTemplate tx() {
+        return new TransactionTemplate(transactionManager);
+    }
+
+    private static Sale pendingSale(UUID storeId, int itemCount) {
+        return sale(storeId, SaleStatus.PENDING_VALIDATION, itemCount);
+    }
+
+    private static Sale sale(UUID storeId, SaleStatus status, int itemCount) {
+        UUID saleId = UUID.randomUUID();
+        List<SaleItem> items = new ArrayList<>();
+        for (int i = 0; i < itemCount; i++) {
+            items.add(new SaleItem(UUID.randomUUID(), saleId, UUID.randomUUID(), null,
+                    "Produit " + i, 1000, 1000, 1));
+        }
+        return new Sale(saleId, storeId, UUID.randomUUID(), null, PaymentMode.CASH,
+                1000 * itemCount, 0, status, NOW, NOW, items);
+    }
