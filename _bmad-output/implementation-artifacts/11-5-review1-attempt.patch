+
+    // ── Story 11.5 — keyset pull indexes ─────────────────────────────────────
+
+    @Test
+    @DisplayName("11.5 — a keyset index that fails is rolled back to its savepoint; the others and the sync still commit")
+    void sync_keyset_index_failure_is_isolated() throws Exception {
+        when(dataSource.getConnection()).thenReturn(connection);
+        when(connection.prepareStatement(contains("information_schema.tables")))
+                .thenReturn(tablesStmt);
+        when(tablesStmt.executeQuery()).thenReturn(tablesRs);
+        when(tablesRs.next()).thenReturn(false);
+        when(connection.createStatement()).thenReturn(execStmt);
+        Savepoint savepoint = mock(Savepoint.class);
+        when(connection.setSavepoint()).thenReturn(savepoint);
+        lenient().doThrow(new SQLException("canceling statement due to lock timeout"))
+                .when(execStmt).execute(TenantSchemaProvisioner.DDL_SYNC_KEYSET_IDX_SALES);
+
+        service.syncNow("kv_ks1234");
+
+        for (String ddl : TenantSchemaProvisioner.DDL_SYNC_KEYSET_INDEXES) {
+            verify(execStmt).execute(ddl);
+        }
+        int count = TenantSchemaProvisioner.DDL_SYNC_KEYSET_INDEXES.size();
+        verify(connection, times(count)).setSavepoint();
+        verify(connection, times(1)).rollback(savepoint);
+        verify(connection, times(count - 1)).releaseSavepoint(savepoint);
+        verify(connection).commit();
+        verify(connection, never()).rollback();
+    }
 }
