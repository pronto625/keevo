<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.keevo</groupId>
    <artifactId>keevo-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>keevo-backend</name>
    <description>Keevo — Backend Spring Boot (Hexagonal Architecture, Multi-tenant)</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Downgrade from 1.21.0 (Linux Docker CE regression) to stable 1.20.4 -->
        <testcontainers.version>1.20.4</testcontainers.version>
        <docker-java.version>3.4.1</docker-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <!-- Story 12.4: latest 1.4.x patch (1.4 line = Boot 3.5; 2.x targets Boot 4) -->
                <version>1.4.14</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ── Web ─────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ── Data JPA ─────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ── Security ─────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- ── OpenAPI / Swagger UI ────────────────────────────────── -->
        <!-- Springdoc OpenAPI: auto-generates /v3/api-docs + /swagger-ui.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.7.0</version>
        </dependency>
        <!-- ── Actuator ─────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── Observability (Story 11.2) — Boot-managed versions ── -->
        <!-- Prometheus scrape format for /actuator/prometheus (token-protected) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Micrometer Tracing → OpenTelemetry; puts traceId/spanId in the MDC -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- OTLP span exporter — disabled by default (KEEVO_OTLP_EXPORT_ENABLED) -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ── Validation ───────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ── PostgreSQL ───────────────────────────────────────── -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── Flyway ───────────────────────────────────────────── -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ── Lombok ───────────────────────────────────────────── -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── JWT ──────────────────────────────────────────────── -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ── Cache (bounded, Story 12.12) ─────────────────────── -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- ── Distributed scheduler lock (Story 13.9) ──────────── -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>6.3.1</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>6.3.1</version>
        </dependency>

        <!-- ── Test ─────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers — integration tests with real PostgreSQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Override docker-java for Docker 29.x API compatibility (api.version in
             src/test/resources/docker-java.properties).
             Alignment check (v1s-15-11, `mvn dependency:tree -Dincludes=com.github.docker-java`):
             docker-java-api, docker-java-transport-zerodep and its transitive docker-java-transport
             all resolve to ${docker-java.version}; Testcontainers 1.20 does not use docker-java-core,
             so there is no core artifact to drift. Re-run the check when bumping Testcontainers. -->
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-api</artifactId>
            <version>${docker-java.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-transport-zerodep</artifactId>
            <version>${docker-java.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Story 10.6: Spring Modulith — @ApplicationModule annotation (package-info.java). Version from the
             Modulith BOM. Compile scope kept (12.6b): spring-modulith-starter-jdbc (via starter-core) already brings
             it at compile scope, so `provided` here would only make the two declarations disagree. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-api</artifactId>
        </dependency>

        <!-- Story 12.4: Spring Modulith Event Publication Registry (JDBC outbox, table public.event_publication,
             created by Flyway — schema initialization disabled in application.yml)
             Story 13.2: spring-modulith-core (and with it ArchUnit) is excluded from the prod jar. It is only the
             module model used by verify()/docs; at runtime it only contributes a guard that fails when an
             ApplicationModuleInitializer bean exists without spring-modulith-runtime (we have neither). No class of
             the events/moments/api jars references org.springframework.modulith.core. Tests keep it (and ArchUnit)
             through spring-modulith-starter-test → spring-modulith-test / spring-modulith-docs. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jdbc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.modulith</groupId>
                    <artifactId>spring-modulith-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Story 10.6: Spring Modulith — module verification + documentation -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Story 10.6 / 12.6b: ArchUnit is NOT declared here. The architecture tests use the ArchUnit core API
             only (no @AnalyzeClasses engine); `com.tngtech.archunit:archunit` comes TRANSITIVELY from
             spring-modulith-core (its own pom fixes 1.4.2; the Modulith BOM does not manage archunit) — since 13.2
             at test scope only, via spring-modulith-starter-test. The former
             pinned archunit-junit5 1.3.0 overrode that transitive version (skew vs. what modulith-core is built on). -->
        <!-- Story 2.4: CSV import -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.10.0</version>
        </dependency>

        <!-- Story v1s-18-1: XLSX export (SXSSF streaming; >= 5.4.0 for CVE-2025-31672) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>

        <!-- v1s-18-3: PDF export templates (Thymeleaf HTML -> OpenHTMLtoPDF / PDFBox) -->
        <dependency>
            <groupId>org.thymeleaf</groupId>
            <artifactId>thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>1.1.22</version>
        </dependency>

        <!-- Story 8.0: Firebase Admin SDK for FCM push notifications -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.3.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <DOCKER_HOST>unix:///var/run/docker.sock</DOCKER_HOST>
                        <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
                    </environmentVariables>
                </configuration>
            </plugin>
            <!-- Story 13.2: the prod classpath must not carry the Modulith module model nor ArchUnit (only tests
                 use them, via spring-modulith-starter-test). Fails the build if an upgrade or a new dependency
                 brings them back at compile/runtime scope. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prod-classpath-banned-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework.modulith:spring-modulith-core:*:*:compile</exclude>
                                        <exclude>org.springframework.modulith:spring-modulith-core:*:*:runtime</exclude>
                                        <exclude>com.tngtech.archunit:archunit:*:*:compile</exclude>
                                        <exclude>com.tngtech.archunit:archunit:*:*:runtime</exclude>
                                    </excludes>
                                    <message>spring-modulith-core / ArchUnit must stay off the prod classpath (test scope only) — exclude them from the dependency that brings them (Story 13.2)</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Story 13.2: runs the boot + event-registry integration tests on the prod runtime classpath, i.e. without
             the test-only Modulith/ArchUnit jars (spring-modulith-core is excluded from the prod jar). CI:
             `mvn -Pprod-classpath test`. -->
        <profile>
            <id>prod-classpath</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <test>EventPublicationRegistryIntegrationTest,ModuleCatalogBootIntegrationTest</test>
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>org.springframework.modulith:spring-modulith-core</classpathDependencyExclude>
                                <classpathDependencyExclude>com.tngtech.archunit:archunit</classpathDependencyExclude>
                                <classpathDependencyExclude>org.springframework.modulith:spring-modulith-test</classpathDependencyExclude>
                                <classpathDependencyExclude>org.springframework.modulith:spring-modulith-docs</classpathDependencyExclude>
                                <classpathDependencyExclude>org.springframework.modulith:spring-modulith-starter-test</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
