# ─────────────────────────────────────────────────────────────
# Keevo Backend — Environment Variables
# Copy this file to .env and fill in your values
# .env is git-ignored and must NEVER be committed
# ─────────────────────────────────────────────────────────────

# ─── PostgreSQL (local dev via docker-compose) ────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5444
POSTGRES_DB=keevo_dev
POSTGRES_USER=keevo
# Prod/staging (ProdSecretsValidator, fail-fast): >= 12 chars, not a dev/CI default
# (keevo_local_pwd, change_me_in_dot_env, ci_password, postgres, keevo, password) nor a
# placeholder (change_me, your_, replace_with, placeholder, xxxxxxxx...). Generate: openssl rand -hex 16
POSTGRES_PASSWORD=change_me_in_dot_env

# ─── JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secret_at_least_256_bits
# Access token: 24h | Refresh token: 180 days / 6 months (Story 8.6 AC8)
JWT_EXPIRATION_MS=15552000000

# ─── JWT RSA Keys ─────────────────────────────────────────────
# Dev: classpath keys bundled in JAR. Prod: absolute path to mounted PEM files.
KEEVO_JWT_PRIVATE_KEY_PATH=classpath:keys/private_key.pem
KEEVO_JWT_PUBLIC_KEY_PATH=classpath:keys/public_key.pem

# ─── Super Admin Bootstrap ────────────────────────────────────
ADMIN_PHONE=+237600000000
# Prod/staging (fail-fast): >= 12 chars, 3 of 4 classes (lower/upper/digit/symbol), <= 72 UTF-8
# bytes, not Admin@1234! nor a placeholder — this example value is REJECTED in prod.
# NEVER use Admin@1234! in prod. Keep comments on their own line: in .env an inline "# ..."
# after a value becomes part of that value.
ADMIN_PASSWORD=change_me_strong_password

# ─── Spring profiles ──────────────────────────────────────────
# Options: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ─── Application ──────────────────────────────────────────────
APP_PORT=4500

# ─── CORS (Story 11.4) ────────────────────────────────────────
# Browser origins allowed to call the API, comma-separated (e.g. https://admin.keevo.cm).
# prod/staging: ONLY these origins (unset → no browser origin allowed, WARN at boot).
# Other profiles: these origins + http://localhost:3000. Never use "*".
# The mobile app and the dashboard's server-side proxy are not subject to CORS.
DASHBOARD_ORIGIN=

# ─── Observability (Story 11.2) ───────────────────────────────
# Static bearer token for GET /actuator/prometheus (Authorization: Bearer <token>).
# Unset/blank → the endpoint answers 404 (no anonymous scrape; prod is publicly routed).
KEEVO_PROMETHEUS_TOKEN=
# OpenTelemetry traces: OTLP export is OFF by default, the app needs no collector.
KEEVO_OTLP_EXPORT_ENABLED=false
KEEVO_OTLP_ENDPOINT=http://localhost:4318/v1/traces
KEEVO_TRACING_SAMPLING_PROBABILITY=0.1

# ─── Flyway ───────────────────────────────────────────────────
# Tenant schema migrations are applied programmatically
FLYWAY_ENABLED=true

# ─── Logging ─────────────────────────────────────────────ad─────
LOG_LEVEL=DEBUG

# ─── FCM Push Notifications ──────────────────────────────────
# Set to true to enable Firebase Cloud Messaging push notifications
KEEVO_FCM_ENABLED=false
# Path to the Firebase service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/home/toor/Project/FreeLance/AI/Keevo/keevo/keevo-1d289-firebase-adminsdk-fbsvc-4094494885.json

# ─── WhatsApp ─────────────────────────────────────────────────────
# Provider: noop (default) | wassender | twilio | failover
#   failover = tries Wassender first, falls back to Twilio automatically
# Prod/staging (fail-fast): the selected provider's vars must be set and not placeholders
#   wassender → WASSENDER_API_URL + WASSENDER_API_TOKEN ; twilio → TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_FROM_NUMBER
#   failover → all of them. The provider name is case-insensitive but must not be empty or padded
#   with spaces (an empty KEEVO_WHATSAPP_PROVIDER= is rejected — omit the line or set noop).
#   noop is allowed (WARN logged: no WhatsApp/OTP delivery). The placeholder tokens below
#   (your_…, ACxxxx…) are REJECTED in prod; the sandbox sender +14155238886 is NOT checked —
#   set your own approved WhatsApp sender for real customers.
KEEVO_WHATSAPP_PROVIDER=noop

# ── Wassender (https://www.wasenderapi.com) ────────────────────────
# Base URL (adapter appends /api/send-message automatically)
WASSENDER_API_URL=https://www.wasenderapi.com
# Session API key from WasenderAPI Dashboard > Session Management (Authorization: Bearer)
WASSENDER_API_TOKEN=your_wassender_api_token_here

# ── Twilio (https://www.twilio.com/docs/whatsapp/api) ─────────────
# Account SID from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auth Token from https://console.twilio.com
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Twilio WhatsApp sender number in E.164 format (Sandbox: +14155238886)
TWILIO_FROM_NUMBER=+14155238886

# ─── SMS / email (Story 19.9) ─────────────────────────────────────
# Provider failover order, comma list (empty = channel disabled, WARN in prod):
#   SMS: mboasms, infobip ; email: resend, infobip
# Prod/staging (fail-fast): every listed provider needs its vars (not placeholders):
#   mboasms → MBOASMS_BASE_URL + MBOASMS_API_KEY ; infobip → INFOBIP_BASE_URL + INFOBIP_API_KEY ;
#   resend → RESEND_API_KEY ; an enabled email channel also needs KEEVO_EMAIL_FROM.
KEEVO_SMS_PROVIDERS=
# Default alphanumeric sender id (max 11 characters)
KEEVO_SMS_SENDER_ID=BrefPoint
MBOASMS_BASE_URL=
MBOASMS_API_KEY=
# Infobip base URL, e.g. xxxxxx.api.infobip.com (shared by SMS and email)
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
KEEVO_EMAIL_PROVIDERS=
KEEVO_EMAIL_FROM=
KEEVO_EMAIL_FROM_NAME=
RESEND_API_KEY=

# ─── Expo push (Story 19.9) ───────────────────────────────────────
# React Native app tokens (ExponentPushToken[…]); off by default, turn on in prod
KEEVO_EXPO_PUSH_ENABLED=false
# Optional Expo access token (enhanced push security), sent as Authorization: Bearer
EXPO_ACCESS_TOKEN=

# ─── Sign-in codes (Story 19.2) ───────────────────────────────────
# Dialing prefixes accepted for phone sign-in codes (comma list, no +); others → PHONE_COUNTRY_NOT_SUPPORTED
KEEVO_AUTH_ALLOWED_PHONE_PREFIXES=237,241,235,243,221
# Store-review account (Apple/Google/Meta reviewers): fixed identifier + code (>= 6 digits).
# Empty = disabled. Its requests send nothing; change both after each review campaign.
KEEVO_OTP_REVIEW_IDENTIFIER=
KEEVO_OTP_REVIEW_CODE=

# ─── Exports (v1s-18-1) ───────────────────────────────────────────
# HMAC secret of the signed export download links, >= 32 chars (shorter fails the boot).
# Blank = random per boot: links of finished exports stop working after a restart (WARN logged).
# Generate: openssl rand -hex 32
KEEVO_EXPORT_LINK_SECRET=

# ─── Aide & Tutoriels (v1s-14-6, FR7) ─────────────────────────────
# External http(s) link (e.g. YouTube) of each ~2 min French tutorial video.
# Blank = « Bientôt disponible » in the app; non-http(s) values are ignored.
KEEVO_HELP_TUTORIAL_VENDRE_URL=
KEEVO_HELP_TUTORIAL_CATALOGUE_URL=
KEEVO_HELP_TUTORIAL_INVENTAIRE_URL=
KEEVO_HELP_TUTORIAL_RAPPORTS_URL=
KEEVO_HELP_TUTORIAL_EQUIPE_URL=
KEEVO_HELP_TUTORIAL_HORS_LIGNE_URL=
