        "storedState": "UNPAID",
        "rows": [],
        "newRow": {
          "amount": 30000,
          "paidAt": "2026-11-05"
        }
      },
      "expected": {
        "state": "PARTIAL",
        "amountPaid": 30000,
        "amountDue": 100000
      }
